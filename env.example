# Resend — transactional email for the contact form (EPIC-007)
RESEND_API_KEY=

# Cloudflare R2 — media/asset storage (EPIC-008)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Scrumtrulescent Magazine — read-only Payload REST API fetch (EPIC-007)
# Leave unset until the magazine is live; getFeaturedMagazineArticles()
# returns [] gracefully when these are empty.
MAGAZINE_API_URL=
MAGAZINE_API_KEY=

# Spotify — per-request fetch of the "10s" playlist for /about/the-way-i-am
# (EPIC-018). The playlist must be public.
# Leave unset and getTensPlaylist() falls back to src/lib/spotify-snapshot.json.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=
# Optional: the full playlist beyond the 100-row cap. The sanctioned API
# refuses playlist tracks for this dev-mode app, so the reader uses the
# Spotify web session cookie. Copy the value of the `sp_dc` cookie from an
# open.spotify.com session (DevTools > Application > Cookies). Unofficial:
# it can break when Spotify changes internals and expires ~yearly; the
# reader falls back to the snapshot when it does. Kept local only.
SPOTIFY_SP_DC=
# Optional legacy path: a user refresh token from
#   node scripts/spotify-authorize.mjs
# Only helps apps grandfathered into playlist-tracks API access.
SPOTIFY_REFRESH_TOKEN=

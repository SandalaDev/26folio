# Contact form delivery (EPIC-028). Values live in the Cloudflare environment
# and the gitignored .env.local, never in the repository.
# Resend sending key (secret).
RESEND_API_KEY=
# Full from header, display name included. Domain is send.sandala.site.
RESEND_FROM_EMAIL=
# Where inquiries are delivered (secret, never committed).
CONTACT_TO_EMAIL=
# Cloudflare Turnstile. Local development can use the published test keys
# listed in planning/dependencies/DEC-20261008-contact-delivery.md.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare R2 — media/asset storage (EPIC-008)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Scrumtrulescent Magazine — read-only Payload REST API fetch (EPIC-007)
# Leave unset until the magazine is live; getFeaturedMagazineArticles()
# returns [] gracefully when these are empty.
MAGAZINE_API_URL=
MAGAZINE_API_KEY=

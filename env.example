# Resend — transactional email for the contact form (EPIC-007)
RESEND_API_KEY=

# Cloudflare R2 — media/asset storage (EPIC-008)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Scrumtrulescent Magazine — read-only Payload REST API fetch (EPIC-007)
# Leave unset until the magazine is live; getFeaturedMagazineArticles()
# returns [] gracefully when these are empty.
MAGAZINE_API_URL=
MAGAZINE_API_KEY=

# Spotify — build-time fetch of the "10s" playlist for /about/the-way-i-am
# (EPIC-018). Client-credentials flow; the playlist must be public.
# Leave unset and getTensPlaylist() falls back to src/lib/spotify-snapshot.json.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=

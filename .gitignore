# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# Agent OS generated views
/dashboard.html
/guide.html
/project-state/current-state.md
/project-state/metrics.md

# Agent OS v2 local caches, workers, and atomic-write files
/.agent-os-cache/
/.agent-os-worktrees/
/project-state/state.json.write-lock
/project-state/*.tmp-*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# Harness-local permissions
/.claude/settings.local.json

# typescript
*.tsbuildinfo

# vercel
.vercel

# solo-dev-os generated slop-score artifacts (written by stop-slop/score.mjs)
planning/content/.slop/

# obsidian volatile UI state (per-machine; keeps re-appearing as modified)
.obsidian/workspace.json
.obsidian/appearance.json

# scratch working directory (PDF page extracts, contact sheets, throwaway crops).
# Files here are inputs to a session, never deliverables — keep them on disk,
# out of history.
/tmp/

# Owner-supplied project originals, unoptimized and not web-safe (filenames with
# spaces, 4500px PNGs, unminified SVGs). Ignored so `git add -A` can't ship 22MB
# of raw source into the deploy. EPIC-026 TASK-093 normalizes these and commits
# the optimized derivatives under public/images/projects/<slug>/ instead.
/public/projects/

# obsidian vault clutter — personal notes/screenshots, not project artifacts
/Pasted image*.png
/obsidian images/
/ui plans/
/meeting on techlife.md
/00-inbox/

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-ops",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../sandala-client-ops",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}

# Cloudflare static assets headers (EPIC-028 TASK-129).
# Hashed build output never changes, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Site images keep their names when replaced, so cache for a day.
/images/*
  Cache-Control: public, max-age=86400
/projects/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=604800
